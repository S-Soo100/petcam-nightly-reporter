# Supabase (mac-runner .env 값 복사)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack Incoming Webhook (mac-runner .env 값 복사)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Cloudflare R2 (petcam-lab .env 값 복사 — ACCOUNT_ID 는 endpoint 에 포함되어 불필요)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=petcam-clips

# 워커 설정
WINDOW_HOURS=2

# 활동필터 worker (activity_worker — Claude/VLM 0회, 상황판 worker 와 별도 launchd job).
# GATE_CHECKPOINT_PATH 미설정 시 config 기본값(../myPythonProjects/gecko-vision-gate/runs/gecko_v2/...) 사용.
# 카메라 UUID 는 여기 넣지 않는다 — allowlist 는 DB camera_activity_filter_settings 로만 관리.
GATE_CHECKPOINT_PATH=/absolute/path/to/gecko-vision-gate/runs/gecko_v2/checkpoint_best_ema.pth
GATE_THRESHOLD=0.25
# ⚠️ activity shadow launchd(install-launchd-activity.sh)는 ACTIVITY_POLICY_VERSION=activity-v1 을 명시적으로
#    override 한다(DB active_policy_version='activity-v1' 과 일치). 아래 기본값은 로컬/수동 실행용이며 그대로 둔다.
ACTIVITY_POLICY_VERSION=activity-v0
ACTIVITY_WINDOW_HOURS=24
ACTIVITY_BATCH_LIMIT=200

# camera_clips 라벨링 격리 제안. preview 전용 기본값이며 두 스위치를 명시적으로 켜기 전엔 0건 처리.
LABELING_TRIAGE_ENABLED=0
LABELING_TRIAGE_WRITE_ENABLED=0
LABELING_TRIAGE_POLICY_VERSION=labeling-triage-v1
LABELING_TRIAGE_ACTIVITY_POLICY_VERSION=activity-v1
LABELING_TRIAGE_WINDOW_HOURS=168
LABELING_TRIAGE_BATCH_LIMIT=30
LABELING_TRIAGE_FRAMES=12

# VLM 후보 worker. 기본은 direct API지만 launchd installer는 구독 기반 CLI batch를 명시한다.
# direct_api를 쓸 때만 ANTHROPIC_API_KEY가 필요하다. claude_cli_batch는 Claude Code 로그인을 사용한다.
VLM_PROVIDER=direct_api
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_EXACT=claude-sonnet-5
VLM_ROUTER_ENABLED=0
# Production candidate worker required. Must equal the verified Mac mini hostname.
# 미설정이면 enabled worker 는 DB/Claude 접근 전 fail-closed(§6.1). 실제 hostname 을 하드코딩하지 않는다.
VLM_EXPECTED_HOST=
VLM_MONTHLY_BUDGET_USD=10.00
VLM_RESERVED_COST_USD=0.10

# 전 영상 Python evidence worker (python_evidence_worker) — activity worker 와 완전 독립.
# 기본 비활성. enabled 여야 실행되고, migration 없는 상태에서 신규 table query 0 을 보장한다.
# EXPECTED_HOST 는 검증된 Mac mini hostname(자동 승인 금지). BATCH_LIMIT 은 [1,200] clamp.
PYTHON_EVIDENCE_ENABLED=0
PYTHON_EVIDENCE_BATCH_LIMIT=30
PYTHON_EVIDENCE_EXPECTED_HOST=
# evidence 전용 Gate threshold(activity GATE_THRESHOLD 와 분리). 검증된 0.10 고정. (0,1] 아니면 fail-closed.
PYTHON_EVIDENCE_GATE_THRESHOLD=0.10
# sparse Gate 최소 프레임. 미달이면 prelabel 저장 없이 terminal(불완전 프레임 gecko absent 금지).
PYTHON_EVIDENCE_MIN_FRAMES=6

# 짧은 영상 장치 오류 격리·보존 worker (short_clip_retention_worker) — 메타데이터 전용 감지 +
# 7일 보존 후 exact R2 삭제. 감지/쓰기/삭제 독립 switch, 기본 전부 비활성(운영 효과 0).
# EXPECTED_HOST 는 검증된 Mac mini hostname(자동 승인 금지). BATCH [1,200], DELETE [1,30] clamp.
SHORT_CLIP_RETENTION_ENABLED=0
SHORT_CLIP_RETENTION_WRITE_ENABLED=0
SHORT_CLIP_RETENTION_DELETE_ENABLED=0
SHORT_CLIP_RETENTION_EXPECTED_HOST=
SHORT_CLIP_RETENTION_BATCH_LIMIT=100
SHORT_CLIP_RETENTION_DELETE_LIMIT=30
SHORT_CLIP_RETENTION_CANDIDATE_UNDER_SEC=15
SHORT_CLIP_RETENTION_REPORT_HOUR_KST=9
# Gecko Motion Engine production shadow (기본 비활성, Mac mini exact host에서만 opt-in)
GME_ENABLED=0
GME_EXPECTED_HOST=
GME_BATCH_LIMIT=4
GME_MAX_LIVE_LAG_SEC=900
GME_GATE_THRESHOLD=0.5
GME_ANALYSIS_FPS=30
GME_ANCHOR_INTERVAL_SEC=0.5
GME_CHECKPOINT_PATH=
GME_DETECTOR_BACKEND=yolo26n
GME_CHECKPOINT_SHA256=
GME_DETECTOR_IDENTITY=
GME_RAW_CONFIDENCE=0.001
GME_SCORE_THRESHOLD=0.20
GME_IMAGE_SIZE=960
GME_NMS_IOU=0.70
GME_MAX_DETECTIONS=50
GME_DEVICE=mps
