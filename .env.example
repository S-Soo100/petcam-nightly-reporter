# Supabase (mac-runner .env 값 복사)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack Incoming Webhook (mac-runner .env 값 복사)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Cloudflare R2 (petcam-lab .env 값 복사 — ACCOUNT_ID 는 endpoint 에 포함되어 불필요)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=petcam-clips

# 워커 설정
WINDOW_HOURS=2

# 활동필터 worker (activity_worker — Claude/VLM 0회, 상황판 worker 와 별도 launchd job).
# GATE_CHECKPOINT_PATH 미설정 시 config 기본값(../myPythonProjects/gecko-vision-gate/runs/gecko_v2/...) 사용.
# 카메라 UUID 는 여기 넣지 않는다 — allowlist 는 DB camera_activity_filter_settings 로만 관리.
GATE_CHECKPOINT_PATH=/absolute/path/to/gecko-vision-gate/runs/gecko_v2/checkpoint_best_ema.pth
GATE_THRESHOLD=0.25
# ⚠️ activity shadow launchd(install-launchd-activity.sh)는 ACTIVITY_POLICY_VERSION=activity-v1 을 명시적으로
#    override 한다(DB active_policy_version='activity-v1' 과 일치). 아래 기본값은 로컬/수동 실행용이며 그대로 둔다.
ACTIVITY_POLICY_VERSION=activity-v0
ACTIVITY_WINDOW_HOURS=24
ACTIVITY_BATCH_LIMIT=200

# camera_clips 라벨링 격리 제안. preview 전용 기본값이며 두 스위치를 명시적으로 켜기 전엔 0건 처리.
LABELING_TRIAGE_ENABLED=0
LABELING_TRIAGE_WRITE_ENABLED=0
LABELING_TRIAGE_POLICY_VERSION=labeling-triage-v1
LABELING_TRIAGE_ACTIVITY_POLICY_VERSION=activity-v1
LABELING_TRIAGE_WINDOW_HOURS=168
LABELING_TRIAGE_BATCH_LIMIT=30
LABELING_TRIAGE_FRAMES=12

# VLM 후보 worker. 기본은 direct API지만 launchd installer는 구독 기반 CLI batch를 명시한다.
# direct_api를 쓸 때만 ANTHROPIC_API_KEY가 필요하다. claude_cli_batch는 Claude Code 로그인을 사용한다.
VLM_PROVIDER=direct_api
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_EXACT=claude-sonnet-5
VLM_ROUTER_ENABLED=0
# Production candidate worker required. Must equal the verified Mac mini hostname.
# 미설정이면 enabled worker 는 DB/Claude 접근 전 fail-closed(§6.1). 실제 hostname 을 하드코딩하지 않는다.
VLM_EXPECTED_HOST=
VLM_MONTHLY_BUDGET_USD=10.00
VLM_RESERVED_COST_USD=0.10
